# Copy to .env and fill in. .env is git-ignored.

# Cloudflare Zero Trust organization (team name) to enroll into
WARP_ORG=your-team-name

# Browser (PAC) routing: only these go through warpbox, everything else is DIRECT.
# Comma-separated domain suffixes (a suffix also matches the bare domain)
PAC_DOMAINS=internal.example.com,example.net
# Comma-separated IPs reached by address (e.g. servers you open by IP)
PAC_IPS=

# macOS network service the PAC is applied to (see: networksetup -listallnetworkservices)
WARPBOX_NET_SERVICE=Wi-Fi
