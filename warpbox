#!/usr/bin/env bash
# warpbox — Cloudflare WARP isolated in a Docker container; Mac reaches company servers via SOCKS5.
#
#   warpbox up              start container (connects if already enrolled)
#   warpbox down            stop container — nothing runs, nothing is reported
#   warpbox status          container + WARP status
#   warpbox login           first-time enrollment: prints the browser URL
#   warpbox token '<link>'  finish enrollment with the com.cloudflare.warp://… link from the browser
#   warpbox run <cmd…>      run one command with ALL_PROXY through warpbox (curl, scripts)
#   warpbox env             print proxy exports (eval "$(warpbox env)")
#   warpbox pac on|off      system auto-proxy (PAC; macOS or GNOME): only PAC_DOMAINS / PAC_IPS from .env via warpbox
#   warpbox logs | shell

set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Local settings (WARP_ORG, WARPBOX_NET_SERVICE, …) — see .env.example
[[ -f "$DIR/.env" ]] && set -a && source "$DIR/.env" && set +a
PROXY="socks5h://127.0.0.1:1080"
PAC_URL="http://127.0.0.1:1081/proxy.pac"
NET_SERVICE="${WARPBOX_NET_SERVICE:-Wi-Fi}"

dc() { docker compose -f "$DIR/compose.yaml" "$@"; }
wc_() { docker exec warpbox warp-cli --accept-tos "$@"; }

case "${1:-}" in
    up)
        dc up -d --build
        sleep 3
        wc_ status || true
        ;;
    down)
        wc_ disconnect >/dev/null 2>&1 || true
        dc down
        ;;
    status)
        docker ps --filter name=warpbox --format '{{.Names}}: {{.Status}}' | grep . || { echo "warpbox: not running"; exit 0; }
        wc_ status || true
        wc_ registration show 2>/dev/null | grep -E 'Organization|Account type' || echo "not enrolled — run: warpbox login"
        ;;
    login)
        echo "Open the URL below in your browser and log in."
        echo "On the final page, right-click 'Open Cloudflare WARP' → Copy Link, then run:"
        echo "  warpbox token '<copied com.cloudflare.warp://… link>'"
        echo
        wc_ registration new "${WARP_ORG:?set WARP_ORG in $DIR/.env}" 2>&1 | grep -Eo 'https://[^ ]+' || wc_ registration new "${WARP_ORG:?set WARP_ORG in $DIR/.env}"
        ;;
    token)
        [[ -n "${2:-}" ]] || { echo "usage: warpbox token '<com.cloudflare.warp://… link>'"; exit 1; }
        wc_ registration token "$2"
        wc_ connect
        sleep 3
        wc_ status
        ;;
    run)
        shift
        ALL_PROXY="$PROXY" all_proxy="$PROXY" HTTPS_PROXY="$PROXY" HTTP_PROXY="$PROXY" "$@"
        ;;
    env)
        echo "export ALL_PROXY=$PROXY all_proxy=$PROXY HTTPS_PROXY=$PROXY HTTP_PROXY=$PROXY"
        ;;
    pac)
        if [[ "$(uname -s)" == "Darwin" ]]; then
            case "${2:-}" in
                on)  networksetup -setautoproxyurl "$NET_SERVICE" "$PAC_URL" && networksetup -setautoproxystate "$NET_SERVICE" on ;;
                off) networksetup -setautoproxystate "$NET_SERVICE" off ;;
                *)   networksetup -getautoproxyurl "$NET_SERVICE" ;;
            esac
        elif command -v gsettings >/dev/null 2>&1; then
            # Ubuntu / GNOME system proxy (used by Chrome/Chromium; Firefox: "Use system proxy settings")
            case "${2:-}" in
                on)  gsettings set org.gnome.system.proxy autoconfig-url "$PAC_URL" && gsettings set org.gnome.system.proxy mode 'auto' ;;
                off) gsettings set org.gnome.system.proxy mode 'none' ;;
                *)   echo "mode: $(gsettings get org.gnome.system.proxy mode)  url: $(gsettings get org.gnome.system.proxy autoconfig-url)" ;;
            esac
        else
            echo "No system proxy tool found — set the browser's automatic proxy URL to $PAC_URL by hand."
            exit 1
        fi
        ;;
    logs)  docker exec warpbox tail -n 100 -f /var/log/warp-svc.log ;;
    shell) docker exec -it warpbox bash ;;
    *)     sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
